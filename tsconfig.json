{
  // Type checking only — the app stays plain JavaScript and Vite builds it
  // as before. Run with `npm run typecheck`.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node", "vite-plugin-pwa/client"],
    "skipLibCheck": true,
    "strict": false
  },
  // All app code and scripts. Tests are not checked yet.
  "include": [
    "src/types.d.ts",
    "src/*.js",
    "src/data/**/*.js",
    "src/parsers/**/*.js",
    "src/context/**/*.js",
    "src/screens/**/*.js",
    "src/utils/**/*.js",
    "scripts/**/*.mjs"
  ]
}
